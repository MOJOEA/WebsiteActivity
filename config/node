############################################################
# SETUP : Activity.localhost (MVC Project บน XAMPP)
# Project Path:
# C:\xampp\htdocs\Project\WebsiteActivity
############################################################


############################################################
# STEP 0 : เตรียมโปรเจกต์ (โฟลเดอร์งาน)
############################################################
# สร้างโฟลเดอร์โปรเจกต์
# C:\xampp\htdocs\Project\WebsiteActivity

# สร้างโฟลเดอร์ public (Apache ต้องชี้มาที่นี่)
# C:\xampp\htdocs\Project\WebsiteActivity\public

# สร้างไฟล์ทดสอบ
# public/index.php
# --------------------------------
# <?php
# echo "Hello, World!";
# --------------------------------


############################################################
# STEP 1 : เปิดใช้งาน Virtual Host ใน Apache
############################################################
# ไฟล์:
# C:\xampp\apache\conf\httpd.conf

# ต้องตรวจสอบให้แน่ใจว่าบรรทัดนี้ "ไม่มี #"
# --------------------------------
# Include conf/extra/httpd-vhosts.conf
# --------------------------------
# ถ้ามี # ข้างหน้า → Apache จะไม่อ่าน Virtual Host


############################################################
# STEP 2 : สร้าง Virtual Host : Activity.localhost
############################################################
# ไฟล์:
# C:\xampp\apache\conf\extra\httpd-vhosts.conf

# เพิ่มโค้ดนี้ไว้ "ล่างสุดของไฟล์"
# --------------------------------
# <VirtualHost *:80>
#     ServerName Activity.localhost
#     DocumentRoot "C:/xampp/htdocs/Project/WebsiteActivity/public"
#
#     <Directory "C:/xampp/htdocs/Project/WebsiteActivity/public">
#         AllowOverride All
#         Require all granted
#     </Directory>
# </VirtualHost>
# --------------------------------

# หมายเหตุ:
# - ต้องใช้ / ไม่ใช่ \
# - ต้องชี้ไปที่ public เท่านั้น


############################################################
# STEP 3 : ผูกชื่อ Activity.localhost กับเครื่อง (hosts)
############################################################
# เปิด Notepad แบบ Run as Administrator

# ไฟล์:
# C:\Windows\System32\drivers\etc\hosts

# เพิ่มบรรทัดนี้
# --------------------------------
# 127.0.0.1 Activity.localhost
# --------------------------------


############################################################
# STEP 4 : Restart Apache
############################################################
# เปิด XAMPP Control Panel
# Stop Apache
# Start Apache ใหม่
# (ขั้นนี้ห้ามข้าม)


############################################################
# STEP 5 : ทดสอบ Virtual Host
############################################################
# เปิด Browser แล้วเข้า
# --------------------------------
# http://Activity.localhost
# --------------------------------

# ถ้าถูกต้อง จะเห็น:
# Hello, World!


############################################################
# STEP 6 : เช็คกรณีมีปัญหา (Advanced Check)
############################################################
# เปิด CMD หรือ Git Bash แล้วพิมพ์
httpd -S

# ต้องเห็นชื่อ:
# namevhost Activity.localhost
# ถ้าไม่เห็น → Apache ยังไม่โหลด vhost


############################################################
# สรุป Flow การทำงาน
############################################################
# Browser
#  → Activity.localhost
#  → Apache VirtualHost
#  → DocumentRoot (/public)
#  → index.php
#  → แสดงผล
############################################################
